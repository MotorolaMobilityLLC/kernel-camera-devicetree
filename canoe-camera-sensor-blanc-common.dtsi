#include <dt-bindings/msm-camera.h>

&pmk8850_gpios {
        /* uw - s5kjns - mck1 */
        cam_sensor_mclk1_1p8_active: cam_sensor_mclk1_1p8_active {
                        pins = "gpio2";
                        function = "func2";
                        output-enable;
                        power-source = <0>; /* 1.8 V */
        };

        cam_sensor_mclk1_1p8_suspend: cam_sensor_mclk1_1p8_suspend {
                        pins = "gpio2";
                        function = "func2";
                        bias-high-impedance;
        };
};

&tlmm {
	cam_dvdd_main_en_default: cam_dvdd_main_en_default {
		mux {
			pins = "gpio164";
			function = "gpio";
		};

		config {
			pins = "gpio164";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_avdd_main_en_default: cam_avdd_main_en_default {
		mux {
			pins = "gpio163";
			function = "gpio";
		};

		config {
			pins = "gpio163";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_avdd2_main_en_default: cam_avdd2_main_en_default {
		mux {
			pins = "gpio208";
			function = "gpio";
		};

		config {
			pins = "gpio208";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_vdd_0p9_en_default: cam_vdd_0p9_en_default {
		mux {
			pins = "gpio166";
			function = "gpio";
		};

		config {
			pins = "gpio166";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_afvdd_main_en_default: cam_afvdd_main_en_default {
		mux {
			pins = "gpio165";
			function = "gpio";
		};

		config {
			pins = "gpio165";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_iovdd_main_en_default: cam_iovdd_main_en_default {
		mux {
			pins = "gpio168";
			function = "gpio";
		};

		config {
			pins = "gpio168";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_oisvdd_main_en_default: cam_oisvdd_main_en_default {
		mux {
			pins = "gpio212";
			function = "gpio";
		};

		config {
			pins = "gpio212";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_iovdd_en_default: cam_iovdd_en_default {
		mux {
			pins = "gpio167";
			function = "gpio";
		};

		config {
			pins = "gpio167";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};
	cam_sensor_active_rst8: cam_sensor_active_rst8 {
		mux {
			pins = "gpio8";
			function = "gpio";
		};

		config {
			pins = "gpio8";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_suspend_rst8: cam_sensor_suspend_rst8 {
		mux {
			pins = "gpio8";
			function = "gpio";
		};

		config {
			pins = "gpio8";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
			output-low;
		};
	};

	cam_avdd_uw_en_default: cam_avdd_uw_en_default {
		mux {
			pins = "gpio160";
			function = "gpio";
		};

		config {
			pins = "gpio160";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};
};

&soc {

	cam_avdd_main: gpio-regulator@0 {
		compatible = "regulator-fixed";
		reg = <0x00 0x00>;
		regulator-name = "cam_avdd_main";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 163 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_avdd_main_en_default>;
		vin-supply = <&S8F>;
	};

	cam_avdd2_main: gpio-regulator@2 {
		compatible = "regulator-fixed";
		reg = <0x02 0x00>;
		regulator-name = "cam_avdd2_main";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 208 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_avdd2_main_en_default>;
		vin-supply = <&vdd_cam_3p0>;
	};

	cam_vdd_0P9: gpio-regulator@3 {
		compatible = "regulator-fixed";
		reg = <0x03 0x00>;
		regulator-name = "cam_vdd_0P9";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 166 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_vdd_0p9_en_default>;
		vin-supply = <&BOB1>;
	};

	cam_dvdd_main: gpio-regulator@4 {
		compatible = "regulator-fixed";
		reg = <0x04 0x00>;
		regulator-name = "cam_dvdd_main";
		regulator-min-microvolt = <810000>;
		regulator-max-microvolt = <810000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 164 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_dvdd_main_en_default>;
		vin-supply = <&cam_vdd_0P9>;
	};

	cam_afvdd_main: gpio-regulator@5 {
		compatible = "regulator-fixed";
		reg = <0x05 0x00>;
		regulator-name = "cam_afvdd_main";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 165 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_afvdd_main_en_default>;
		vin-supply = <&BOB1>;
	};

	cam_iovdd_main: gpio-regulator@6 {
		compatible = "regulator-fixed";
		reg = <0x06 0x00>;
		regulator-name = "cam_iovdd_main";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 168 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_iovdd_main_en_default>;
		vin-supply = <&S7F>;
	};

	cam_fold_front_iovdd: gpio-regulator@7 {
		compatible = "regulator-fixed";
		regulator-name = "cam_fold_front_iovdd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&gpio_expander 13 0>;
		enable-active-high;
		depends-on-supply = <&gpio_expander>;
		vin-supply = <&BOB1>;
	};

	cam_fold_front_vdd: gpio-regulator@8 {
		compatible = "regulator-fixed";
		regulator-name = "cam_fold_front_vdd";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&gpio_expander 14 0>;
		enable-active-high;
		depends-on-supply = <&gpio_expander>;
		vin-supply = <&S7F>;
	};

	cam_fold_front_avdd: gpio-regulator@9 {
		compatible = "regulator-fixed";
		regulator-name = "cam_fold_front_avdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&gpio_expander 15 0>;
		enable-active-high;
		depends-on-supply = <&gpio_expander>;
		vin-supply = <&BOB1>;
	};
	cam_iovdd: gpio-regulator@10 {
		compatible = "regulator-fixed";
		reg = <0x07 0x00>;
		regulator-name = "cam_iovdd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 167 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_iovdd_en_default>;
		vin-supply = <&S8F>;
	};

	cam_oisvdd_main: gpio-regulator@11 {
		compatible = "regulator-fixed";
		reg = <0x11 0x00>;
		regulator-name = "cam_oisvdd_main";
		regulator-min-microvolt = <3200000>;
		regulator-max-microvolt = <3200000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 212 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_oisvdd_main_en_default>;
		vin-supply = <&BOB1>;
	};

	cam_avdd_uw: gpio-regulator@12 {
		compatible = "regulator-fixed";
		reg = <0x12 0x00>;
		regulator-name = "cam_avdd_uw";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 160 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_avdd_uw_en_default>;
		vin-supply = <&vdd_cam_3p0>;
	};


