&qupv3_se8_i2c {
	status = "ok";
	qcom,high-perf;
	qcom,clk-freq-out = <1000000>;
	qcom,pm-ctrl-client;

	front_fold: qcom,cam-sensor@4 {
		cell-index = <4>;
		reg = <0x36>;
		compatible = "qcom,cam-i2c-sensor";
		csiphy-sd-index = <1>;
		sensor-position-roll = <270>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <0>;
		cam_v_custom1-supply = <&cam_iovdd>;
		cam_vio-supply = <&cam_fold_front_iovdd>;
		cam_vdig-supply = <&cam_fold_front_vdd>;
		power-domains   = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		cam_vana-supply = <&cam_fold_front_avdd>;
		regulator-names = "cam_v_custom1","cam_vio", "cam_vdig", "cam_vana";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 1800000 1200000 2800000>;
		rgltr-max-voltage = <1800000 1800000 1200000 2800000>;
		rgltr-load-current = <3500 3500   913200  91430>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk2_active &cam_sensor_active_rst8>;
		pinctrl-1 = <&cam_sensor_mclk2_suspend &cam_sensor_suspend_rst8>;
		gpios = <&tlmm 91 0>,
			<&tlmm 8 0>;
		gpio-reset = <1>;
		gpio-req-tbl-num = <0 1>;
		gpio-req-tbl-flags = <1 0>;
		gpio-req-tbl-label = "CAMIF_MCLK2","CAM_RESET8";
		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK2_CLK>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <19200000>;
		status = "ok";
	};
};
