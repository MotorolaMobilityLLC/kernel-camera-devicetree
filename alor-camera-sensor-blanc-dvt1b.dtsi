		/* SCL3 */
		mux {
			pins = "gpio7";
			function = "cci_i2c_scl3";
		};

		config {
			pins = "gpio7";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_scl3_suspend_overlay: cci_i2c_scl3_suspend_overlay {
		/* SCL3 */
		mux {
			pins = "gpio7";
			function = "cci_i2c_scl3";
		};

		config {
			pins = "gpio7";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	qupv3_se8_i2c_pins_overlay: qupv3_se8_i2c_pins_overlay {
		qupv3_se8_i2c_sda_active_overlay: qupv3_se8_i2c_sda_active_overlay {
			mux {
				pins = "gpio0";
				function = "qup2_se0_l0";
			};

			config {
				pins = "gpio0";
				drive-strength = <2>;
				bias-disable;
				qcom,apps;
			};
		};

		qupv3_se8_i2c_scl_active_overlay: qupv3_se8_i2c_scl_active_overlay {
			mux {
				pins = "gpio1";
				function = "qup2_se0_l1";
			};

			config {
				pins = "gpio1";
				drive-strength = <2>;
				bias-disable;
				qcom,apps;
			};
		};

		qupv3_se8_i2c_sleep_overlay: qupv3_se8_i2c_sleep_overlay {
			mux {
				pins = "gpio0", "gpio1";
				function = "gpio";
			};

			config {
				pins = "gpio0", "gpio1";
				drive-strength = <2>;
				qcom,remote;
			};
		};
	};

	qupv3_se9_i2c_pins_overlay: qupv3_se9_i2c_pins_overlay {
		qupv3_se9_i2c_sda_active_overlay: qupv3_se9_i2c_sda_active_overlay {
			mux {
