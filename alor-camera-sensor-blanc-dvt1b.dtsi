			pins = "gpio114";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_sda1_active_overlay: cci_i2c_sda1_active_overlay {
		/* SDA1 */
		mux {
			pins = "gpio115";
			function = "cci_i2c_sda1";
		};

		config {
			pins = "gpio115";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_sda1_suspend_overlay: cci_i2c_sda1_suspend_overlay {
		/* SDA1 */
		mux {
			pins = "gpio115";
			function = "cci_i2c_sda1";
		};

		config {
			pins = "gpio115";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_scl1_active_overlay: cci_i2c_scl1_active_overlay{
		/* SCL1 */
		mux {
			pins = "gpio116";
			function = "cci_i2c_scl1";
		};

		config {
			pins = "gpio116";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_scl1_suspend_overlay: cci_i2c_scl1_suspend_overlay {
		/* SCL1 */
		mux {
			pins = "gpio116";
			function = "cci_i2c_scl1";
		};

		config {
			pins = "gpio116";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_sda3_active_overlay: cci_i2c_sda3_active_overlay {
		/* SDA3 */
		mux {
			pins = "gpio111";
			function = "cci_i2c_sda3";
		};

		config {
			pins = "gpio111";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_sda3_suspend_overlay: cci_i2c_sda3_suspend_overlay {
		/* SDA3 */
