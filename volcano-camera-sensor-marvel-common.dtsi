#include <dt-bindings/msm-camera.h>

&tlmm {
	cci_i2c_sda0_active_overlay: cci_i2c_sda0_active_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio88";
			function = "cci_i2c_sda0";
		};

		config {
			pins = "gpio88";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_sda0_suspend_overlay: cci_i2c_sda0_suspend_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio88";
			function = "cci_i2c_sda0";
		};

		config {
			pins = "gpio88";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_scl0_active_overlay: cci_i2c_scl0_active_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio89";
			function = "cci_i2c_scl0";
		};

		config {
			pins = "gpio89";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_scl0_suspend_overlay: cci_i2c_scl0_suspend_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio89";
			function = "cci_i2c_scl0";
		};

		config {
			pins = "gpio89";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_sda1_active_overlay: cci_i2c_sda1_active_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio90";
			function = "cci_i2c_sda1";
		};

		config {
			pins = "gpio90";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_sda1_suspend_overlay: cci_i2c_sda1_suspend_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio90";
			function = "cci_i2c_sda1";
		};

		config {
			pins = "gpio90";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_scl1_active_overlay: cci_i2c_scl1_active_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio91";
			function = "cci_i2c_scl1";
		};

		config {
			pins = "gpio91";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_scl1_suspend_overlay: cci_i2c_scl1_suspend_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio91";
			function = "cci_i2c_scl1";
		};

		config {
			pins = "gpio91";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_sda2_active_overlay: cci_i2c_sda2_active_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio92";
			function = "cci_i2c_sda2";
		};

		config {
			pins = "gpio92";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_sda2_suspend_overlay: cci_i2c_sda2_suspend_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio92";
			function = "cci_i2c_sda2";
		};

		config {
			pins = "gpio92";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_scl2_active_overlay: cci_i2c_scl2_active_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio93";
			function = "cci_i2c_scl2";
		};

		config {
			pins = "gpio93";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_scl2_suspend_overlay: cci_i2c_scl2_suspend_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio93";
			function = "cci_i2c_scl2";
		};

		config {
			pins = "gpio93";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_sda3_active_overlay: cci_i2c_sda3_active_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio94";
			function = "cci_i2c_sda3";
		};

		config {
			pins = "gpio94";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_sda3_suspend_overlay: cci_i2c_sda3_suspend_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio94";
			function = "cci_i2c_sda3";
		};

		config {
			pins = "gpio94";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_scl3_active_overlay: cci_i2c_scl3_active_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio95";
			function = "cci_i2c_scl3";
		};

		config {
			pins = "gpio95";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci_i2c_scl3_suspend_overlay: cci_i2c_scl3_suspend_overlay {
		mux {
			/* CLK, DATA */
			pins = "gpio95";
			function = "cci_i2c_scl3";
		};

		config {
			pins = "gpio95";
			bias-disable;
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_avdd_tele_en_default: cam_avdd_tele_en_default {
		mux {
			pins = "gpio17";
			function = "gpio";
		};

		config {
			pins = "gpio17";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_afvdd_tele_en_default: cam_afvdd_tele_en_default {
		mux {
			pins = "gpio16";
			function = "gpio";
		};

		config {
			pins = "gpio16";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_oisvdd_tele_en_default: cam_oisvdd_tele_en_default {
		mux {
			pins = "gpio18";
			function = "gpio";
		};

		config {
			pins = "gpio18";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_iovdd_en_default: cam_iovdd_en_default {
		mux {
			pins = "gpio21";
			function = "gpio";
		};

		config {
			pins = "gpio21";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_avdd_1p8_main_en_default: cam_avdd_1p8_main_en_default {
		mux {
			pins = "gpio22";
			function = "gpio";
		};

		config {
			pins = "gpio22";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_avdd_front_en_default: cam_avdd_front_en_default {
		mux {
			pins = "gpio23";
			function = "gpio";
		};

		config {
			pins = "gpio23";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};
};

&pmxr2230_flash0 {
	qcom,duration-ms = <500>;
	qcom,max-current-ma = <1200>;
};

&soc {
	led_flash_rear_main: qcom,camera-flash0 {
		cell-index = <0>;
		compatible = "qcom,camera-flash";
		flash-source = <&pmxr2230_flash0>;
		torch-source = <&pmxr2230_torch0>;
		switch-source = <&pmxr2230_switch2>;
		status = "ok";
	};

	led_flash_rear_uw: qcom,camera-flash2 {
		cell-index = <2>;
		compatible = "qcom,camera-flash";
		flash-source = <&pmxr2230_flash0>;
		torch-source = <&pmxr2230_torch0>;
		switch-source = <&pmxr2230_switch2>;
		status = "ok";
	};

	led_flash_rear_tele: qcom,camera-flash3 {
		cell-index = <3>;
		compatible = "qcom,camera-flash";
		flash-source = <&pmxr2230_flash0>;
		torch-source = <&pmxr2230_torch0>;
		switch-source = <&pmxr2230_switch2>;
		status = "ok";
	};

	cam_avdd_tele: gpio-regulator@0 {
		compatible = "regulator-fixed";
		reg = <0x00 0x00>;
		regulator-name = "cam_avdd_tele";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 17 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_avdd_tele_en_default>;
		vin-supply = <&BOB>;
	};

	cam_iovdd: gpio-regulator@1 {
		compatible = "regulator-fixed";
		reg = <0x01 0x00>;
		regulator-name = "cam_iovdd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 21 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_iovdd_en_default>;
		vin-supply = <&S1B>;
	};

	cam_afvdd_tele: gpio-regulator@2 {
		compatible = "regulator-fixed";
		reg = <0x02 0x00>;
		regulator-name = "cam_afvdd_tele";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 16 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_afvdd_tele_en_default>;
		vin-supply = <&BOB>;
	};

	cam_oisvdd_tele: gpio-regulator@3 {
		compatible = "regulator-fixed";
		reg = <0x03 0x00>;
		regulator-name = "cam_oisvdd_tele";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 18 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_oisvdd_tele_en_default>;
		vin-supply = <&BOB>;
	};
	cam_avdd1_main: gpio-regulator@4 {
		compatible = "regulator-fixed";
		reg = <0x04 0x00>;
		regulator-name = "cam_avdd1_main";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 22 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_avdd_1p8_main_en_default>;
		vin-supply = <&S1B>;
	};

	cam_avdd_front: gpio-regulator@5 {
		compatible = "regulator-fixed";
		reg = <0x05 0x00>;
		regulator-name = "cam_avdd_front";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <233>;
		enable-active-high;
		gpio = <&tlmm 23 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_avdd_front_en_default>;
		vin-supply = <&BOB>;
	};

	qcom,cam-res-mgr {
		compatible = "qcom,cam-res-mgr";
		status = "ok";
	};
};

&cam_cci0 {
	pinctrl-0 = <&cci_i2c_scl0_active_overlay &cci_i2c_sda0_active_overlay>;
	pinctrl-1 = <&cci_i2c_scl0_suspend_overlay &cci_i2c_sda0_suspend_overlay>;
	pinctrl-2 = <&cci_i2c_scl1_active_overlay &cci_i2c_sda1_active_overlay>;
	pinctrl-3 = <&cci_i2c_scl1_suspend_overlay &cci_i2c_sda1_suspend_overlay>;

	/* Sensor (Wide S5KJNS/GC13A2) */
	actuator_uw: qcom,actuator@2 {
		cell-index = <2>;
		compatible = "qcom,actuator";
		cci-master = <0>;
		cam_vaf-supply = <&cam_ldo4_rw_afvdd>;
		regulator-names = "cam_vaf";
		rgltr-cntrl-support;
		rgltr-min-voltage = <2800000>;
		rgltr-max-voltage = <2800000>;
		rgltr-load-current = <103000>;
		status = "ok";
	};

	eeprom_uw: qcom,eeprom@2 {
		cell-index = <2>;
		reg = <0x2>;
		compatible = "qcom,eeprom";
		cci-master = <CCI_MASTER_0>;
		cam_vio-supply = <&cam_iovdd>;
		regulator-names = "cam_vio";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000>;
		rgltr-max-voltage = <1800000>;
		rgltr-load-current = <0>;
		status = "ok";
	};

	rear_uw: qcom,cam-sensor@2 {
		cell-index = <2>;
		compatible = "qcom,cam-sensor";

		csiphy-sd-index = <0>;

		sensor-position-roll  = <90>;
		sensor-position-pitch = <0>;
		sensor-position-yaw   = <180>;

		led-flash-src = <&led_flash_rear_uw>;
		actuator-src  = <&actuator_uw>;
		eeprom-src    = <&eeprom_uw>;

		cam_vio-supply  = <&cam_iovdd>;
		cam_vdig-supply = <&cam_ldo1_rw_dvdd>;
		cam_clk-supply  = <&cam_cc_camss_top_gdsc>;
		cam_vana-supply = <&cam_ldo3_rw_avdd>;
		cam_vaf-supply = <&cam_ldo4_rw_afvdd>;
		regulator-names = "cam_vio","cam_vdig","cam_clk","cam_vana","cam_vaf";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 1050000 0 2800000 2800000>;
		rgltr-max-voltage = <1800000 1104000 0 2800000 2800000>;
		rgltr-load-current = <101000  680000 0 1000 103000>;

		gpio-no-mux = <0>;

		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk0_active &cam_sensor_active_rst0>;
		pinctrl-1 = <&cam_sensor_mclk0_suspend &cam_sensor_suspend_rst0>;

		gpios              = <&tlmm 83 0>,<&tlmm 40 0>;
		gpio-reset         = <1>;
		gpio-req-tbl-num   = <0 1>;
		gpio-req-tbl-flags = <1 0>;
		gpio-req-tbl-label = "CAMIF_MCLK0","CAM_RESET0";

		cci-master = <CCI_MASTER_0>;

		clocks           = <&camcc CAM_CC_MCLK0_CLK>;
		clock-names      = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates      = <24000000>;

		status = "ok";
	};

	/* Sensor (Tele GC13B0) */
	actuator_rear_tele: qcom,actuator@3 {
		cell-index = <3>;
		compatible = "qcom,actuator";
		cci-master = <CCI_MASTER_1>;
		cam_vio-supply = <&cam_iovdd>;
		cam_vaf-supply = <&cam_afvdd_tele>;
		cam_v_custom2-supply = <&cam_oisvdd_tele>;
		regulator-names = "cam_vio", "cam_vaf", "cam_v_custom2";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 2800000 2800000>;
		rgltr-max-voltage = <1800000 2800000 2800000>;
		rgltr-load-current = <36000 120000 140000>;
		af-ois-use-same-ic;
		status = "ok";
	};

	ois_rear_tele: qcom,ois@3 {
		cell-index = <3>;
		compatible = "qcom,ois";
		cci-master = <CCI_MASTER_1>;
		cam_vio-supply = <&cam_iovdd>;
		cam_vaf-supply = <&cam_afvdd_tele>;
		cam_v_custom2-supply = <&cam_oisvdd_tele>;
		regulator-names = "cam_vio", "cam_vaf", "cam_v_custom2";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 2800000 2800000>;
		rgltr-max-voltage = <1800000 2800000 2800000>;
		rgltr-load-current = <36000 120000 140000>;
		af-ois-use-same-ic;
		status = "ok";
	};

	eeprom_tele: qcom,eeprom@3 {
		cell-index = <3>;
		reg = <0x3>;
		compatible = "qcom,eeprom";
		cci-master = <CCI_MASTER_1>;
		cam_vio-supply = <&cam_iovdd>;
		regulator-names = "cam_vio";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000>;
		rgltr-max-voltage = <1800000>;
		rgltr-load-current = <36000>;
		status = "ok";
	};

	qcom,cam-sensor@3 {
		cell-index = <3>;
		compatible = "qcom,cam-sensor";
		csiphy-sd-index = <1>;
		sensor-position-roll = <90>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <180>;
		led-flash-src = <&led_flash_rear_tele>;
		eeprom-src = <&eeprom_tele>;
		actuator-src = <&actuator_rear_tele>;
		ois-src = <&ois_rear_tele>;
		cam_vio-supply = <&cam_iovdd>;
		cam_vdig-supply = <&cam_ldo2_tl_dvdd>;
		cam_clk-supply = <&cam_cc_camss_top_gdsc>;
		cam_vana-supply = <&cam_avdd_tele>;
		regulator-names = "cam_vio", "cam_vdig", "cam_clk", "cam_vana";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 1150000 0 2800000>;
		rgltr-max-voltage = <1800000 1152000 0 2800000>;
		rgltr-load-current = <36000 162000 0 70000>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk1_active
				 &cam_sensor_active_rst1>;
		pinctrl-1 = <&cam_sensor_mclk1_suspend
				 &cam_sensor_suspend_rst1>;
		gpios = <&tlmm 84 0>,
			<&tlmm 41 0>;
		gpio-reset = <1>;
		gpio-req-tbl-num = <0 1>;
		gpio-req-tbl-flags = <1 0>;
		gpio-req-tbl-label = "CAMIF_MCLK1",
					"CAM_RESET1";
		cci-master = <CCI_MASTER_1>;
		clocks = <&camcc CAM_CC_MCLK1_CLK>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <24000000>;
		status = "ok";
	};
};

&cam_cci1 {
	pinctrl-0 = <&cci_i2c_scl2_active_overlay &cci_i2c_sda2_active_overlay>;
	pinctrl-1 = <&cci_i2c_scl2_suspend_overlay &cci_i2c_sda2_suspend_overlay>;
	pinctrl-2 = <&cci_i2c_scl3_active_overlay &cci_i2c_sda3_active_overlay>;
	pinctrl-3 = <&cci_i2c_scl3_suspend_overlay &cci_i2c_sda3_suspend_overlay>;

	actuator_main: qcom,actuator@0 {
		cell-index = <0>;
		compatible = "qcom,actuator";
		cci-master = <CCI_MASTER_0>;
		cam_vaf-supply = <&cam_ldo4_rm_afvdd>;
		regulator-names = "cam_vaf";
		rgltr-cntrl-support;
		rgltr-min-voltage = <2800000>;
		rgltr-max-voltage = <2800000>;
		rgltr-load-current = <103000>;
		status = "ok";
	};

	eeprom_main: qcom,eeprom@0 {
		cell-index = <0>;
		reg = <0x0>;
		compatible = "qcom,eeprom";
		cci-master = <CCI_MASTER_0>;
		cam_vio-supply  = <&cam_iovdd>;
		regulator-names = "cam_vio";
		rgltr-cntrl-support;
		rgltr-min-voltage  = <1800000>;
		rgltr-max-voltage  = <1800000>;
		rgltr-load-current = <155000>;
		status = "ok";
	};

	rear_main: qcom,cam-sensor@0 {
		cell-index = <0>;
		compatible = "qcom,cam-sensor";
		csiphy-sd-index = <2>;
		sensor-position-roll = <90>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <180>;
		led-flash-src = <&led_flash_rear_main>;
		actuator-src  = <&actuator_main>;
		eeprom-src    = <&eeprom_main>;
		cam_vio-supply  = <&cam_iovdd>;
		cam_vana-supply = <&cam_ldo3_rm_avdd>;
		cam_vdig-supply = <&cam_ldo1_rm_dvdd>;
		cam_v_custom1-supply = <&cam_avdd1_main>;
		cam_vaf-supply = <&cam_ldo4_rm_afvdd>;
		cam_clk-supply  = <&cam_cc_camss_top_gdsc>;
		regulator-names = "cam_vio", "cam_vana", "cam_vdig", "cam_v_custom1", "cam_vaf", "cam_clk" ;
		rgltr-cntrl-support;
		rgltr-min-voltage  = <1800000 2800000 1104000 1800000 2800000 0>;
		rgltr-max-voltage  = <1800000 2800000 1104000 1800000 2800000 0>;
		rgltr-load-current = <155000 155000 680000 119000 103000 0>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk2_active	&cam_sensor_active_rst2>;
		pinctrl-1 = <&cam_sensor_mclk2_suspend	&cam_sensor_suspend_rst2>;
		gpios = <&tlmm 85 0>, <&tlmm 42 0>;
		gpio-reset = <1>;
		gpio-req-tbl-num   = <0 1>;
		gpio-req-tbl-flags = <1 0>;
		gpio-req-tbl-label = "CAMIF_MCLK2", "CAM_RESET2";
		cci-master = <CCI_MASTER_0>;
		clocks = <&camcc CAM_CC_MCLK2_CLK>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <24000000>;
		status = "ok";
	};

	/*sensor front s5kjns/gc32e1*/
	eeprom_front: qcom,eeprom@1 {
		cell-index = <1>;
		reg = <0x1>;
		compatible = "qcom,eeprom";
		cci-master = <CCI_MASTER_1>;
		cam_vio-supply = <&cam_iovdd>;
		regulator-names = "cam_vio";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000>;
		rgltr-max-voltage = <1800000>;
		rgltr-load-current = <0>;
		status = "ok";
	};
	front_main: qcom,cam-sensor1 {
		cell-index = <1>;
		compatible = "qcom,cam-sensor";
		csiphy-sd-index = <3>;
		eeprom-src = <&eeprom_front>;
		sensor-position-roll = <270>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <0>;
		cam_vio-supply = <&cam_iovdd>;
		cam_vdig-supply = <&cam_ldo2_ft_dvdd>;
		cam_clk-supply = <&cam_cc_camss_top_gdsc>;
		cam_vana-supply = <&cam_avdd_front>;
		regulator-names = "cam_vio", "cam_vdig","cam_clk", "cam_vana";
		rgltr-cntrl-support;
		rgltr-min-voltage = <1800000 1050000 0 2800000>;
		rgltr-max-voltage = <1800000 1200000 0 2800000>;
		rgltr-load-current = <3000 680000 0  50000>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk3_active
				 &cam_sensor_active_rst3>;
		pinctrl-1 = <&cam_sensor_mclk3_suspend
				 &cam_sensor_suspend_rst3>;
		gpios = <&tlmm 86 0>,
			<&tlmm 43 0>;
		gpio-reset = <1>;
		gpio-req-tbl-num = <0 1>;
		gpio-req-tbl-flags = <1 0>;
		gpio-req-tbl-label = "CAMIF_MCLK3",
					"CAM_RESET3";
		cci-master = <CCI_MASTER_1>;
		clocks = <&camcc CAM_CC_MCLK3_CLK>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <24000000>;
		status = "ok";
	};

};


