#include "alor-camera-sensor-mtp.dtsi"

&eeprom_wide {
	cam_vdig-supply = <&L2M>;
	rgltr-min-voltage = <1800000 1100000 2800000 2800000 1800000>;
	rgltr-max-voltage = <1800000 1100000 2800000 2800000 1800000>;
	rgltr-load-current = <3500 913200 91430 118930 63100>;
};

&sensor_wide {
	cam_vdig-supply = <&L2M>;
	rgltr-min-voltage = <1800000 1100000 2800000 2800000 1800000>;
	rgltr-max-voltage = <1800000 1100000 2800000 2800000 1800000>;
	rgltr-load-current = <3500 913200 91430 118930 63100>;
};
